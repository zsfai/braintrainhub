---
import { localePath, t, type Locale } from '../i18n';
import Disclaimer from './Disclaimer.astro';

interface Props {
  locale?: Locale;
}

const { locale = 'zh' } = Astro.props;
const ui = t(locale);
const year = new Date().getFullYear();
const lp = (path: string) => localePath(locale, path);
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__intro">
      <p class="site-footer__brand">{ui.siteName}</p>
      <p class="site-footer__tagline">{ui.tagline}</p>
      <p class="site-footer__about">{ui.footerAbout}</p>
    </div>
    <Disclaimer locale={locale} />
    <div class="site-footer__meta">
      <span>© {year} {ui.siteName}</span>
      <a href={lp('/faq/')}>{ui.footerFaq}</a>
      <a href={lp('/about/')}>{ui.footerAboutLink}</a>
      <a href={lp('/tools/')}>{ui.footerTools}</a>
      <a href={lp('/plans/')}>{ui.footerPlans}</a>
    </div>
  </div>
</footer>
