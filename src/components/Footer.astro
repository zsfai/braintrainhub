---
import { t } from '../i18n';
import Disclaimer from './Disclaimer.astro';

const ui = t('zh');
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__intro">
      <p class="site-footer__brand">{ui.siteName}</p>
      <p class="site-footer__tagline">{ui.tagline}</p>
      <p class="site-footer__about">{ui.footerAbout}</p>
    </div>
    <Disclaimer />
    <div class="site-footer__meta">
      <span>© {year} {ui.siteName}</span>
      <a href="/faq/">常见问题</a>
      <a href="/about/">关于与声明</a>
      <a href="/tools/">训练工具</a>
      <a href="/plans/">训练计划</a>
    </div>
  </div>
</footer>
