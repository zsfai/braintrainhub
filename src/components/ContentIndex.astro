---
import Breadcrumb from './Breadcrumb.astro';
import { kindLabel, kindPath, levelLabel, type AnyEntry, type ContentKind } from '../lib/content';

interface Props {
  kind: ContentKind;
  entries: AnyEntry[];
  lead: string;
}

const { kind, entries, lead } = Astro.props;
const label = kindLabel(kind);
---

<div class="page-container">
  <Breadcrumb
    items={[
      { name: '首页', path: '/' },
      { name: label, path: kindPath(kind) },
    ]}
  />
  <header class="page-hero">
    <h1>{label}</h1>
    <p>{lead}</p>
  </header>
  <div class="index-grid">
    {
      entries.map((entry, index) => (
        <a
          class="index-item reveal-item"
          href={`${kindPath(kind)}${entry.id}/`}
          style={`transition-delay: ${index * 60}ms`}
        >
          <div class="index-item__meta">
            <span class="badge">{levelLabel(entry.data.level)}</span>
            <span>{entry.data.category}</span>
          </div>
          <h2 class="index-item__title">{entry.data.title}</h2>
          <p class="index-item__desc">{entry.data.description}</p>
        </a>
      ))
    }
  </div>
</div>

<script>
  const items = document.querySelectorAll('.reveal-item');
  const io = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          io.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.15 },
  );
  items.forEach((item) => io.observe(item));
</script>
