---
import Breadcrumb from '../Breadcrumb.astro';
import DirectAnswer from '../DirectAnswer.astro';
import FaqList from '../FaqList.astro';
import { getFaqs } from '../../i18n/faq';
import { localePath, t, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = t(locale);
const faq = ui.faq;
const items = getFaqs(locale);
const lp = (path: string) => localePath(locale, path);
---

<div class="page-container page-container--narrow">
  <Breadcrumb
    items={[
      { name: ui.breadcrumbHome, path: '/' },
      { name: faq.title, path: '/faq/' },
    ]}
    locale={locale}
  />
  <header class="page-hero">
    <h1>{faq.title}</h1>
  </header>
    <DirectAnswer text={faq.directAnswer} locale={locale} />
    <FaqList items={items} heading={faq.title} />
  <p style="margin-top: 1.5rem;">
    <a href={lp('/about/')}>{ui.footerAboutLink}</a>
    ·
    <a href={lp('/tools/')}>{ui.footerTools}</a>
  </p>
</div>
