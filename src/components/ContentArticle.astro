---
import DirectAnswer from './DirectAnswer.astro';
import Breadcrumb from './Breadcrumb.astro';
import {
  entrySlug,
  kindLabel,
  kindPath,
  levelLabel,
  type ContentKind,
  type AnyEntry,
} from '../lib/content';
import { getTool } from '../lib/tools-i18n';
import { localePath, t, type Locale } from '../i18n';

interface Props {
  kind: ContentKind;
  entry: AnyEntry;
  related: AnyEntry[];
  locale?: Locale;
}

const { kind, entry, related, locale = 'zh' } = Astro.props;
const ui = t(locale);
const base = kindPath(kind, locale);
const slug = entrySlug(entry.id);
const crumbs = [
  { name: ui.breadcrumbHome, path: '/' },
  { name: kindLabel(kind, locale), path: base },
  { name: entry.data.h1, path: `${base}${slug}/` },
];
const tools = (entry.data.relatedTools ?? [])
  .map((s) => getTool(s, locale))
  .filter((tool): tool is NonNullable<typeof tool> => Boolean(tool));
---

<article class="page-container page-container--narrow">
  <Breadcrumb items={crumbs} locale={locale} />
  <header class="page-hero">
    <div class="index-item__meta" style="margin-bottom: 0.75rem;">
      <span class="badge">{levelLabel(entry.data.level, locale)}</span>
      <span>{entry.data.category}</span>
      {entry.data.updated && (
        <span>
          {ui.updatedOn} {entry.data.updated}
        </span>
      )}
    </div>
    <h1>{entry.data.h1}</h1>
  </header>
    <DirectAnswer text={entry.data.directAnswer} locale={locale} />
  <div class="content-prose">
    <slot />
  </div>

  {
    tools.length > 0 && (
      <section class="tool-intro">
        <h2>{ui.relatedToolsTitle}</h2>
        <div class="related-list">
          {tools.map((tool) => (
            <a href={tool.path}>
              {tool.title} — {tool.focus}
            </a>
          ))}
        </div>
      </section>
    )
  }

  {
    related.length > 0 && (
      <section class="tool-intro">
        <h2>{ui.related}</h2>
        <div class="related-list">
          {related.map((item) => (
            <a href={`${base}${entrySlug(item.id)}/`}>{item.data.title}</a>
          ))}
        </div>
      </section>
    )
  }
</article>
