---
import Breadcrumb from './Breadcrumb.astro';
import { localePath, t, type Locale } from '../i18n';

interface Props {
  locale?: Locale;
  title: string;
  focus: string;
  summary: string;
  principleHref: string;
  principleLabel: string;
  methodHref?: string;
  methodLabel?: string;
  planHref?: string;
  planLabel?: string;
  tips?: string[];
  toolPath: string;
}

const {
  locale = 'zh',
  title,
  focus,
  summary,
  principleHref,
  principleLabel,
  methodHref,
  methodLabel,
  planHref,
  planLabel,
  tips = [],
  toolPath,
} = Astro.props;
const ui = t(locale);
---

<div class="page-container">
  <Breadcrumb
    items={[
      { name: ui.breadcrumbHome, path: '/' },
      { name: ui.kindTools, path: '/tools/' },
      { name: title, path: toolPath },
    ]}
    locale={locale}
  />
  <header class="page-hero page-hero--minimal">
    <div class="index-item__meta" style="margin-bottom: 0.5rem;">
      <span class="badge">{focus}</span>
    </div>
    <h1>{title}</h1>
    <p id="direct-answer" class="page-hero__summary">{summary}</p>
  </header>

  <slot />

  <section class="tool-intro">
    <h2>{ui.toolHowTo}</h2>
    {
      tips.length > 0 && (
        <ul class="tool-tips">
          {tips.map((tip) => (
            <li>{tip}</li>
          ))}
        </ul>
      )
    }
    <div class="related-list">
      <a href={principleHref}>{ui.toolPrinciple}：{principleLabel}</a>
      {methodHref && methodLabel && <a href={methodHref}>{ui.toolMethod}：{methodLabel}</a>}
      {planHref && planLabel && <a href={planHref}>{ui.toolPlan}：{planLabel}</a>}
    </div>
  </section>
</div>
