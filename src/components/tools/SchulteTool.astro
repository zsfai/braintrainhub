---
import '../../styles/tools.css';
import { getToolMessages } from '../../i18n/tool-messages';
import { t, type Locale } from '../../i18n';
import { schulteProUrl as getSchulteProUrl } from '../../lib/schulte-pro';

interface Props {
  locale?: Locale;
}

const { locale = 'zh' } = Astro.props;
const ui = t(locale);
const m = getToolMessages(locale);
const proUrl = getSchulteProUrl(locale);
---

<div class="tool-pro-callout">
  <p class="tool-pro-callout__title">{m.schulte.proTitle}</p>
  <p class="tool-pro-callout__desc">{m.schulte.proDesc}</p>
  <a class="btn btn--primary" href={proUrl} target="_blank" rel="noopener noreferrer">
    {m.schulte.proLink}
  </a>
</div>

<div id="schulte-app" class="tool-shell">
  <div class="tool-toolbar">
    <div class="btn-row">
      <label>
        {m.schulte.size}
        <select class="tool-select" data-size>
          <option value="3">3×3</option>
          <option value="4">4×4</option>
          <option value="5" selected>5×5</option>
          <option value="6">6×6</option>
        </select>
      </label>
      <button type="button" class="btn btn--primary" data-start>{m.schulte.startSpace}</button>
    </div>
    <div class="tool-stats">
      <span>{m.schulte.time} <strong data-timer>0.00s</strong></span>
      <span>{m.schulte.errors} <strong data-errors>0</strong></span>
      <span>{ui.bestScore} <strong data-best>—</strong></span>
      <span>{ui.lastScore} <strong data-last>—</strong></span>
    </div>
  </div>
  <p class="schulte-target">
    {m.schulte.next}<strong data-target>1</strong>
    <span class="tool-countdown" data-countdown aria-live="polite"></span>
  </p>
  <div class="schulte-grid" data-grid aria-label={m.schulte.gridAria}></div>
  <p class="tool-feedback" data-feedback></p>
  <div class="tool-sessions" data-sessions hidden></div>
</div>

<script>
  import { initSchulte } from '../../scripts/schulte/index.ts';
  const app = document.getElementById('schulte-app');
  if (app) initSchulte(app);
</script>
