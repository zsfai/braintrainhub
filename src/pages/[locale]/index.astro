---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HomePage from '../../components/pages/HomePage.astro';
import { collectionPageSchema } from '../../lib/seo-schemas';
import { absUrl } from '../../lib/page-url';
import { getTools } from '../../lib/tools-i18n';
import { t } from '../../i18n';
import { PREFIXED_LOCALES } from '../../i18n/routing';

export function getStaticPaths() {
  return PREFIXED_LOCALES.map((locale) => ({ params: { locale }, props: { locale } }));
}

const { locale } = Astro.props;
const ui = t(locale);
const home = ui.home;
const schema = collectionPageSchema({
  url: absUrl('/', locale),
  name: home.title,
  description: home.metaDescription,
  items: getTools(locale).map((tool) => ({ name: tool.title, url: absUrl(tool.path, locale) })),
});
---

<BaseLayout
  locale={locale}
  title={home.title}
  description={home.metaDescription}
  canonical="/"
  speakable
  schema={schema}
>
  <HomePage locale={locale} />
</BaseLayout>
