---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import FaqPage from '../../../components/pages/FaqPage.astro';
import { getFaqs } from '../../../i18n/faq';
import { faqPageSchema } from '../../../lib/seo-schemas';
import { absUrl } from '../../../lib/page-url';
import { t } from '../../../i18n';
import { PREFIXED_LOCALES } from '../../../i18n/routing';

export function getStaticPaths() {
  return PREFIXED_LOCALES.map((locale) => ({ params: { locale }, props: { locale } }));
}

const { locale } = Astro.props;
const ui = t(locale);
const faq = ui.faq;
const items = getFaqs(locale);
const schema = faqPageSchema(absUrl('/faq/', locale), items);
---

<BaseLayout
  locale={locale}
  title={faq.title}
  description={faq.metaDescription}
  canonical="/faq/"
  schema={schema}
  speakable
  breadcrumbs={[
    { name: ui.breadcrumbHome, path: '/' },
    { name: faq.title, path: '/faq/' },
  ]}
>
  <FaqPage locale={locale} />
</BaseLayout>
