---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ContentIndex from '../../../components/ContentIndex.astro';
import { getSorted, entrySlug } from '../../../lib/content';
import { collectionCopy } from '../../../i18n/collections';
import { collectionPageSchema } from '../../../lib/seo-schemas';
import { absUrl, entryUrl } from '../../../lib/page-url';
import { t } from '../../../i18n';
import { PREFIXED_LOCALES } from '../../../i18n/routing';

export function getStaticPaths() {
  return PREFIXED_LOCALES.map((locale) => ({ params: { locale }, props: { locale } }));
}

const { locale } = Astro.props;
const entries = await getSorted('principles', locale);
const copy = collectionCopy('principles', locale);
const ui = t(locale);
const schema = collectionPageSchema({
  url: absUrl('/principles/', locale),
  name: copy.title,
  description: copy.description,
  items: entries.map((e) => ({ name: e.data.title, url: entryUrl('principles', e, locale) })),
  locale,
});
---

<BaseLayout
  locale={locale}
  title={copy.title}
  description={copy.description}
  canonical="/principles/"
  speakable
  schema={schema}
  breadcrumbs={[
    { name: ui.breadcrumbHome, path: '/' },
    { name: copy.title, path: '/principles/' },
  ]}
>
  <ContentIndex kind="principles" entries={entries} lead={copy.lead} locale={locale} />
</BaseLayout>
