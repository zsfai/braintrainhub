---
import BaseLayout from '../layouts/BaseLayout.astro';
import { localePath, t } from '../i18n';
import { localeFromPathname } from '../i18n/routing';

const locale = localeFromPathname(Astro.url.pathname);
const n = t(locale).notFound;
---

<BaseLayout locale={locale} title={n.title} description={n.description} canonical="/404/" noindex>
  <div class="page-wrap">
    <header class="page-hero">
      <h1>{n.heading}</h1>
      <p>{n.description}</p>
    </header>
    <section class="prose" aria-labelledby="404-links">
      <h2 id="404-links">{n.try}</h2>
      <ul>
        <li><a href={localePath(locale, '/')}>{n.home}</a></li>
        <li><a href={localePath(locale, '/tools/')}>{t(locale).footerTools}</a></li>
        <li><a href={localePath(locale, '/faq/')}>{t(locale).footerFaq}</a></li>
      </ul>
    </section>
  </div>
</BaseLayout>
