---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentArticle from '../../components/ContentArticle.astro';
import { getSorted, resolveRelated } from '../../lib/content';

export async function getStaticPaths() {
  const entries = await getSorted('principles');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const related = await resolveRelated('principles', entry.data.related);
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  canonical={`/principles/${entry.id}/`}
  article
  datePublished={entry.data.updated}
  dateModified={entry.data.updated}
  breadcrumbs={[
    { name: '首页', path: '/' },
    { name: '原理科普', path: '/principles/' },
    { name: entry.data.h1, path: `/principles/${entry.id}/` },
  ]}
  speakable
>
  <ContentArticle kind="principles" entry={entry} related={related}>
    <Content />
  </ContentArticle>
</BaseLayout>
