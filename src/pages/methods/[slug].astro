---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentArticle from '../../components/ContentArticle.astro';
import { getSorted, resolveRelated, entrySlug } from '../../lib/content';
import { t } from '../../i18n';

export async function getStaticPaths() {
  const entries = await getSorted('methods', 'zh');
  return entries.map((entry) => ({
    params: { slug: entrySlug(entry.id) },
    props: { entry },
  }));
}

const locale = 'zh';
const { entry } = Astro.props;
const { Content } = await render(entry);
const related = await resolveRelated('methods', entry.data.related, locale);
const ui = t(locale);
const slug = entrySlug(entry.id);
const canonical = `/methods/${slug}/`;
---

<BaseLayout
  locale={locale}
  title={entry.data.title}
  description={entry.data.description}
  canonical={canonical}
  article
  datePublished={entry.data.updated}
  dateModified={entry.data.updated}
  breadcrumbs={[
    { name: ui.breadcrumbHome, path: '/' },
    { name: ui.kindMethods, path: '/methods/' },
    { name: entry.data.h1, path: canonical },
  ]}
  speakable
>
  <ContentArticle kind="methods" entry={entry} related={related} locale={locale}>
    <Content />
  </ContentArticle>
</BaseLayout>
