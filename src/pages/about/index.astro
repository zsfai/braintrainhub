---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AboutPage from '../../components/pages/AboutPage.astro';
import { t } from '../../i18n';

const locale = 'zh';
const about = t(locale).about;
---

<BaseLayout
  locale={locale}
  title={about.title}
  description={about.metaDescription}
  canonical="/about/"
  speakable
  breadcrumbs={[
    { name: t(locale).breadcrumbHome, path: '/' },
    { name: t(locale).navAbout, path: '/about/' },
  ]}
>
  <AboutPage locale={locale} />
</BaseLayout>
