---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import DirectAnswer from '../../components/DirectAnswer.astro';
import FaqList from '../../components/FaqList.astro';
import { SITE_FAQS } from '../../content/faq';
import { faqPageSchema } from '../../lib/seo-schemas';
import { SITE_URL } from '../../utils/site';

const title = '常见问题';
const description = '关于 BrainTrainHub 认知训练工具、科普边界、成绩存储与训练计划的简要说明。';
const pageUrl = `${SITE_URL}/faq/`;
const schema = faqPageSchema(pageUrl, SITE_FAQS);
---

<BaseLayout
  title={title}
  description={description}
  canonical="/faq/"
  schema={schema}
  speakable
  breadcrumbs={[
    { name: '首页', path: '/' },
    { name: '常见问题', path: '/faq/' },
  ]}
>
  <div class="page-container page-container--narrow">
    <Breadcrumb
      items={[
        { name: '首页', path: '/' },
        { name: '常见问题', path: '/faq/' },
      ]}
    />
    <header class="page-hero">
      <h1>{title}</h1>
    </header>
    <DirectAnswer text="汇总训练工具、成绩存储、内容边界与计划入门等问题；详细答案见下方列表。" />
    <FaqList items={SITE_FAQS} />
    <p style="margin-top: 1.5rem;">
      <a href="/about/">关于与声明</a>
      ·
      <a href="/tools/">训练工具</a>
    </p>
  </div>
</BaseLayout>
