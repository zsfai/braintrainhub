---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import { htmlLang } from '../i18n';
import {
  SITE_URL,
  SITE_NAME,
  SITE_TAGLINE,
  OG_IMAGE,
  THEME_COLOR,
  articleSchema,
  breadcrumbSchema,
  organizationSchema,
  websiteSchema,
  speakableWebPage,
  type BreadcrumbItem,
} from '../utils/site';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  breadcrumbs?: BreadcrumbItem[];
  article?: boolean;
  ogImage?: string;
  noindex?: boolean;
  datePublished?: string;
  dateModified?: string;
  speakable?: boolean | string[];
}

const {
  title,
  description,
  canonical = '/',
  schema,
  breadcrumbs,
  article = false,
  ogImage = OG_IMAGE,
  noindex = false,
  datePublished,
  dateModified,
  speakable,
} = Astro.props;

const pagePath = canonical.startsWith('/') ? canonical : `/${canonical}`;
const pageUrl = `${SITE_URL}${pagePath}`;
const fullTitle = title.includes(SITE_NAME) ? title : `${title} · ${SITE_NAME}`;
const isHome = pagePath === '/' || pagePath === '';

const extraSchemas: Record<string, unknown>[] = [];

if (breadcrumbs?.length) {
  extraSchemas.push(breadcrumbSchema(breadcrumbs));
}

if (article) {
  extraSchemas.push(
    articleSchema({
      title,
      description,
      url: pageUrl,
      datePublished,
      dateModified,
    }),
  );
}

const speakableSelectors =
  speakable === true
    ? isHome
      ? ['.home-hero__lead', '.direct-answer']
      : ['#direct-answer', '.direct-answer']
    : Array.isArray(speakable)
      ? speakable
      : article
        ? ['#direct-answer', '.direct-answer']
        : null;

if (speakableSelectors) {
  extraSchemas.push(
    speakableWebPage({
      url: pageUrl,
      name: title,
      description,
      cssSelector: speakableSelectors,
    }),
  );
}

const pageSchema = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
const allSchema = [organizationSchema(), websiteSchema(), ...extraSchemas, ...pageSchema];
---

<!doctype html>
<html lang={htmlLang('zh')}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
    />
    <meta name="author" content={SITE_NAME} />
    <meta name="theme-color" content={THEME_COLOR} />
    <link rel="canonical" href={pageUrl} />
    <link rel="alternate" hreflang="zh-CN" href={pageUrl} />
    <link rel="alternate" hreflang="x-default" href={pageUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="zh_CN" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta property="og:image:alt" content={`${SITE_NAME} — ${SITE_TAGLINE}`} />
    <meta name="twitter:image:alt" content={`${SITE_NAME} — ${SITE_TAGLINE}`} />
    <JsonLd data={allSchema} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到主内容</a>
    <Nav canonical={pagePath} />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
