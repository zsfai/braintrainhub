---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import {
  LOCALES,
  htmlLang,
  localeHreflang,
  localeOg,
  localePath,
  siteTagline,
  t,
  type Locale,
} from '../i18n';
import {
  SITE_URL,
  SITE_NAME,
  OG_IMAGE,
  THEME_COLOR,
  articleSchema,
  breadcrumbSchema,
  organizationSchema,
  websiteSchema,
  speakableWebPage,
  type BreadcrumbItem,
} from '../utils/site';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  locale?: Locale;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  breadcrumbs?: BreadcrumbItem[];
  article?: boolean;
  ogImage?: string;
  noindex?: boolean;
  datePublished?: string;
  dateModified?: string;
  speakable?: boolean | string[];
}

const {
  title,
  description,
  canonical = '/',
  locale = 'zh',
  schema,
  breadcrumbs,
  article = false,
  ogImage = OG_IMAGE,
  noindex = false,
  datePublished,
  dateModified,
  speakable,
} = Astro.props;

const ui = t(locale);
const pagePath = localePath(locale, canonical);
const pageUrl = `${SITE_URL}${pagePath}`;
const brandLabel = ui.siteName;
const fullTitle =
  title.includes(SITE_NAME) || title.includes(brandLabel)
    ? title
    : `${title} · ${brandLabel}`;
const isHome = canonical === '/' || canonical === '';
const tagline = siteTagline(locale);
const orgDescription = ui.home.directAnswer;

const extraSchemas: Record<string, unknown>[] = [];

if (breadcrumbs?.length) {
  extraSchemas.push(
    breadcrumbSchema(
      breadcrumbs.map((item) => ({
        ...item,
        path: item.path.startsWith('http') ? item.path : localePath(locale, item.path),
      })),
    ),
  );
}

if (article) {
  extraSchemas.push(
    articleSchema({
      title,
      description,
      url: pageUrl,
      datePublished,
      dateModified,
      inLanguage: localeHreflang(locale),
    }),
  );
}

const speakableSelectors =
  speakable === true
    ? isHome
      ? ['.home-hero__lead', '.direct-answer']
      : ['#direct-answer', '.direct-answer']
    : Array.isArray(speakable)
      ? speakable
      : article
        ? ['#direct-answer', '.direct-answer']
        : null;

if (speakableSelectors) {
  extraSchemas.push(
    speakableWebPage({
      url: pageUrl,
      name: title,
      description,
      cssSelector: speakableSelectors,
    }),
  );
}

const pageSchema = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
const allSchema = [
  organizationSchema(orgDescription),
  websiteSchema(localeHreflang(locale), tagline),
  ...extraSchemas,
  ...pageSchema,
];
const xDefaultUrl = `${SITE_URL}${localePath('zh', canonical)}`;
---

<!doctype html>
<html lang={htmlLang(locale)}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
    />
    <meta name="author" content={brandLabel} />
    <meta name="theme-color" content={THEME_COLOR} />
    <link rel="canonical" href={pageUrl} />
    {
      LOCALES.map((l) => (
        <link rel="alternate" hreflang={localeHreflang(l)} href={`${SITE_URL}${localePath(l, canonical)}`} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={xDefaultUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:site_name" content={brandLabel} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={localeOg(locale)} />
    {
      LOCALES.filter((l) => l !== locale).map((l) => (
        <meta property="og:locale:alternate" content={localeOg(l)} />
      ))
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta property="og:image:alt" content={`${brandLabel} — ${tagline}`} />
    <meta name="twitter:image:alt" content={`${brandLabel} — ${tagline}`} />
    <JsonLd data={allSchema} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">{ui.skipToContent}</a>
    <Nav locale={locale} canonical={canonical} />
    <main id="main-content">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
